#!/usr/bin/env bash
# Displays information about subdomains for a given domain

get_subdomain_info() {
    local domain=$1
    local subdomain=$2
    local output=$(dig +noall +answer "$subdomain.$domain")
    local record_type=$(echo "$output" | awk '{print $4}' | head -n 1)
    local destination=$(echo "$output" | awk '{print $5}' | head -n 1)
    echo "The subdomain $subdomain is a $record_type record and points to $destination"
}

if [ "$#" -eq 1 ]; then
    domain=$1
    for sub in www lb-01 web-01 web-02; do
        get_subdomain_info "$domain" "$sub"
    done
elif [ "$#" -eq 2 ]; then
    domain=$1
    subdomain=$2
    get_subdomain_info "$domain" "$subdomain"
fi

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

# Frontend for HTTP traffic (redirects to HTTPS)
frontend http_front
    bind *:80
    redirect scheme https code 301 if !{ ssl_fc }

# Frontend for HTTPS traffic
frontend https_front
    bind *:443 ssl crt /etc/letsencrypt/live/mchristian-web.duckdns.org/fullchain.pem
    http-request add-header X-Forwarded-Proto https
    default_backend http_back

# Backend for web servers
backend http_back
    balance roundrobin
    server 7259-web-01 16.60.183.4:80 check
    server 7259-web-02 35.178.245.96:80 check
